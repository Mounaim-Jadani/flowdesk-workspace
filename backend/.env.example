# Django Settings
DJANGO_ENV=development
DJANGO_SECRET_KEY=your-super-secret-key-change-in-production

# Database
DB_NAME=chat_db
DB_USER=chat_user
DB_PASSWORD=your-secure-password
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_HOST=localhost

# Security
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional Catch-Me-Up AI provider. Keep the real key only in backend/.env.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL_ARABIC=allam-2-7b
GROQ_MODEL_ARABIC_FALLBACK=qwen/qwen3.8-27b
GROQ_MODEL_GENERAL=openai/gpt-oss-120b
GROQ_MODEL_GENERAL_FALLBACK=allam-2-7b
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b
GROQ_MODEL_GENERAL_LAST_FALLBACK=qwen/qwen3.8-27b
